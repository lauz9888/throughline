{
  "name": "throughline",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "browsers:install": "playwright install --with-deps chromium || playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:bdd": "cucumber-js",
    "pretest:e2e": "npm run browsers:install",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pretest:storybook": "npm run browsers:install",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:coverage:merge": "node scripts/merge-coverage.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/playfair-display": "^5.1.1",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/html-vite": "10.6.7",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-source-maps": "^4.0.4",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "nyc": "^18.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.6",
    "storybook": "10.6.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
